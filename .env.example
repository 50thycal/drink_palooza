# --- Database -----------------------------------------------------------------
# Any Postgres connection string works. On Vercel, add Neon from
# Storage → Create Database and DATABASE_URL is injected automatically.
# POSTGRES_URL, DATABASE_URL_UNPOOLED and POSTGRES_URL_NON_POOLING also work.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# --- Photos (optional but recommended) ----------------------------------------
# On Vercel: Storage → Create → Blob → Connect. Injected automatically.
# Without it, photos are stored (already resized) in Postgres instead.
BLOB_READ_WRITE_TOKEN=""
